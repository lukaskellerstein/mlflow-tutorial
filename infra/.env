COMPOSE_PROJECT_NAME=mlflow-tutorial

# PostgreSQL (shared by MLflow + Temporal)
POSTGRES_VERSION=16
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# MLflow
MLFLOW_DB_NAME=mlflow_db
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow

# Temporal
TEMPORAL_VERSION=1.29.0
TEMPORAL_ADMINTOOLS_VERSION=1.29
TEMPORAL_UI_VERSION=2.34.0
TEMPORAL_DB_NAME=temporal_db
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=temporal

# Elasticsearch (Temporal visibility)
ELASTICSEARCH_VERSION=7.17.27

# Qdrant
QDRANT_VERSION=latest

# Grafana
GRAFANA_VERSION=latest
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Prometheus
PROMETHEUS_VERSION=latest
