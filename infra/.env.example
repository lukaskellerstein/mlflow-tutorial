# Committed template for `infra/.env`, which is local-only and untracked
# (see .gitignore and .claude/rules/12-security.md). First-time setup:
#
#     cp .env.example .env
#
# Every value here is a localhost-only development default, already public in
# README.md § Services (admin/admin for Grafana) and postgres/init-databases.sh.
# Nothing real ever goes in this file or in `.env` — a credential that must be
# versioned is SOPS+age, per 12-security.md.

# --- compose project name ----------------------------------------------------
# Namespaces this stack's containers and volumes. Carried explicitly because
# compose does NOT fail fast when it is unset — it silently falls back to the
# directory name ("infra"). Changing it while a stack exists strands the old
# containers and volumes under the previous name.
COMPOSE_PROJECT_NAME=mlflow-tutorial

# Which tier of the stack compose commands act on. Empty (the default) is the
# Level 1 + Level 2 tier: postgres, mlflow, mlflow-seed, qdrant. `level3` adds
# temporal (+ elasticsearch, UI, admin tools), prometheus and grafana. This is
# the sticky equivalent of `podman compose --profile level3 ...` — set it while
# working through Level 3 so `up`, `down`, `logs` and friends all see the L3
# containers without the flag on every call. Note that a plain `podman compose
# down` stops ONLY the tier it can see: with this empty, running L3 containers
# are left alone.
COMPOSE_PROFILES=

# --- image version pins ------------------------------------------------------
# Deliberately left empty rather than guessed: copy the pins from your local
# `infra/.env`. Compose fails fast and names the variable if one is missing.
POSTGRES_VERSION=
ELASTICSEARCH_VERSION=
TEMPORAL_VERSION=
TEMPORAL_ADMINTOOLS_VERSION=
TEMPORAL_UI_VERSION=
QDRANT_VERSION=
PROMETHEUS_VERSION=
GRAFANA_VERSION=

# --- postgres ----------------------------------------------------------------
# Admin superuser only. The mlflow and temporal users are created with fixed
# dev credentials by postgres/init-databases.sh, not from this file. There are
# deliberately no MLFLOW_DB_* variables: the MLflow server's connection string
# is hardcoded in mlflow/Dockerfile and must match init-databases.sh — adding
# them here would configure nothing.
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# --- temporal ----------------------------------------------------------------
# Must match what init-databases.sh creates.
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=temporal
TEMPORAL_DB_NAME=temporal_db

# --- grafana -----------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- the gateway -------------------------------------------------------------
# There is no proxy container and no gateway key. The MLflow server IS the
# gateway: lessons call http://127.0.0.1:5555/gateway/mlflow/v1 and name an
# alias. The aliases live in mlflow/gateway/seed_gateway.py, which is both the
# list and the script that writes it into the tracking database on every
# `up -d`.
#
# How the MLflow container reaches Unsloth Studio running natively on the host.
# Podman:  http://host.containers.internal:8888/v1   (default below)
# Docker:  http://host.docker.internal:8888/v1
UNSLOTH_API_BASE=http://host.containers.internal:8888/v1

# --- the provider key — A REAL SECRET, never write a value here ---------------
# The only variable in this stack backed by a real credential, so it follows
# 12-security.md rule 1: the secret never enters the repository. It lives in
# ~/.secrets/secrets.enc.yaml (age-encrypted, outside every repo) and is
# delivered to the shell by ~/Projects/.envrc. Compose resolves ${VAR} from the
# shell environment ahead of this file, so the direnv value wins and the name
# below stays empty.
#
# There is exactly one because every alias is local. No OpenRouter, no OpenAI,
# no hosted anything — nothing to bill and nothing else to rotate.
#
# It is NOT optional for a working stack: Unsloth demands a key on every route,
# so a blank one makes mlflow-seed seed nothing at all.
UNSLOTH_API_KEY=
