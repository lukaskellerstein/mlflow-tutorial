# Committed template for `infra/.env`, which is local-only and untracked
# (see .gitignore and .claude/rules/12-security.md). First-time setup:
#
#     cp .env.example .env
#
# Every value here is a localhost-only development default, already public in
# README.md § Services (admin/admin for Grafana) and postgres/init-databases.sh.
# Nothing real ever goes in this file or in `.env` — a credential that must be
# versioned is SOPS+age, per 12-security.md.

# --- compose project name ----------------------------------------------------
# Namespaces this stack's containers and volumes. Carried explicitly because
# compose does NOT fail fast when it is unset — it silently falls back to the
# directory name ("infra"). Changing it while a stack exists strands the old
# containers and volumes under the previous name.
COMPOSE_PROJECT_NAME=mlflow-tutorial

# --- image version pins ------------------------------------------------------
# Deliberately left empty rather than guessed: copy the pins from your local
# `infra/.env`. Compose fails fast and names the variable if one is missing.
POSTGRES_VERSION=
ELASTICSEARCH_VERSION=
TEMPORAL_VERSION=
TEMPORAL_ADMINTOOLS_VERSION=
TEMPORAL_UI_VERSION=
QDRANT_VERSION=
PROMETHEUS_VERSION=
GRAFANA_VERSION=

# --- postgres ----------------------------------------------------------------
# Admin superuser only. The mlflow and temporal users are created with fixed
# dev credentials by postgres/init-databases.sh, not from this file. There are
# deliberately no MLFLOW_DB_* variables: the MLflow server's connection string
# is hardcoded in mlflow/Dockerfile and must match init-databases.sh — adding
# them here would configure nothing.
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# --- temporal ----------------------------------------------------------------
# Must match what init-databases.sh creates.
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=temporal
TEMPORAL_DB_NAME=temporal_db

# --- grafana -----------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- litellm gateway ---------------------------------------------------------
# Local-only master key for the proxy at http://localhost:4000. Lessons send it
# as their api_key; it authenticates against this stack, not against a provider.
LITELLM_MASTER_KEY=sk-litellm-master

# How the gateway container reaches LMStudio running natively on the host.
# Podman:  http://host.containers.internal:1234/v1   (default below)
# Docker:  http://host.docker.internal:1234/v1
LM_STUDIO_API_BASE=http://host.containers.internal:1234/v1

# --- provider keys — REAL SECRETS, never write a value here -------------------
# These are the only variables in this stack backed by real credentials, so they
# follow 12-security.md rule 1: the secret never enters the repository. They live
# in ~/.secrets/secrets.enc.yaml (age-encrypted, outside every repo) and are
# delivered to the shell by ~/Projects/.envrc. Compose resolves ${VAR} from the
# shell environment ahead of this file, so the direnv value wins and both names
# below stay empty.
#
# Only the aliases you actually use need a key: OpenRouter serves gemma-large /
# gemma-26b / gemma-31b, OpenAI serves gpt-mini / frontier.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
