{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "companyAnnouncements": ["Welcome to MLFlow tutorial"],
  "permissions": {
    "allow": [
      "Agent",
      "Artifact",
      "Bash",
      "Cd",
      "Edit",
      "EnterWorktree",
      "ExitPlanMode",
      "Glob",
      "Grep",
      "KillShell",
      "LSP",
      "Monitor",
      "MultiEdit",
      "NotebookEdit",
      "PowerShell",
      "Read",
      "ShareOnboardingGuide",
      "Skill",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "TodoWrite",
      "ToolSearch",
      "WebFetch",
      "WebSearch",
      "Workflow",
      "Write",
      "mcp__docs-langchain",
      "mcp__playwright-mlflow-tutor",
      "mcp__reference-langchain"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -fr /*)",
      "Bash(rm -fr ~*)",
      "Bash(rm -r -f /*)",
      "Bash(rm -r -f ~*)",
      "Bash(mkfs*)",
      "Bash(dd if=*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Edit(./.git/**)",
      "Write(./.git/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Write(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(./secrets/**)",
      "Read(./.secrets/**)",
      "Read(./**/.env.production)",
      "Read(./**/.env.staging)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*credentials*.json)",
      "Read(./**/serviceAccountKey.json)"
    ]
  },
  "enabledPlugins": {
    "dev-tools-plugin@claude-my-marketplace": true,
    "office-plugin@claude-my-marketplace": true,
    "plugin-dev@claude-plugins-official": true
  }
}
