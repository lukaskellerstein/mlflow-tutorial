// REGENERATING: gen-pyrightconfig.py rewrites this file and does NOT preserve
// the three report* keys, the infra/mlflow/gateway exclude, or these comments.
// Re-add them all after any re-run.
{
  "typeCheckingMode": "standard",
  "reportMissingTypeStubs": "none",

  // mlflow lazy-loads its flavor submodules (mlflow.langchain, mlflow.genai,
  // mlflow.openai, ...). They exist at runtime but are not statically
  // re-exported, so the checker reports them as private imports.
  "reportPrivateImportUsage": "none",

  // mlflow.ActiveRun.__exit__ returns `exc_type is None` (declared `bool`), so
  // the checker must assume `with mlflow.start_run()` may swallow an exception
  // and skip its body -- flagging every variable assigned inside as possibly
  // unbound. It never actually suppresses (it returns False when one is live).
  "reportPossiblyUnboundVariable": "none",

  // MLflow base hooks (PythonModel.predict, RunContextProvider.in_context/tags)
  // have no return annotation and empty bodies, so the checker infers `None`
  // and rejects every override that actually returns a value.
  "reportIncompatibleMethodOverride": "none",

  // infra/mlflow/gateway/seed_gateway.py runs INSIDE the MLflow container, which
