  // should not be one -- it is not a lesson leaf. Rooted here the checker
  // resolves its imports against nothing and reports every one as missing, so it
  // is excluded. ruff still lints and formats it (neither needs imports
  // resolved), and it is verified the only way that matters: compose runs it on
  // every `up -d` and prints what it built.
  "exclude": ["**/.venv", "**/node_modules", "**/__pycache__", "infra/mlflow/gateway"],
